-- Ativa a verificação das chaves estrangeiras no SQLite
-- Isso ajuda a manter os relacionamentos entre as tabelas
PRAGMA foreign_keys = ON;


-- CRIAÇÃO DA TABELA ALUNO

CREATE TABLE aluno (
    -- Identifica cada aluno de forma única
    id_aluno INTEGER PRIMARY KEY AUTOINCREMENT,

    -- Nome do aluno, sendo obrigatório
    nome TEXT NOT NULL,

    -- Turma do aluno, sendo obrigatória
    turma TEXT NOT NULL
);


-- CRIAÇÃO DA TABELA DISCIPLINA

CREATE TABLE disciplina (
    -- Identifica cada disciplina de forma única
    id_disciplina INTEGER PRIMARY KEY AUTOINCREMENT,

    -- Nome da disciplina, sendo obrigatório
    nome TEXT NOT NULL
);


-- CRIAÇÃO DA TABELA MATRÍCULA


CREATE TABLE matricula (
    -- Identifica cada matrícula
    id_matricula INTEGER PRIMARY KEY AUTOINCREMENT,

    -- Chave estrangeira que identifica o aluno
    id_aluno INTEGER NOT NULL,

    -- Chave estrangeira que identifica a disciplina
    id_disciplina INTEGER NOT NULL,

    -- Relaciona a matrícula com a tabela aluno
    FOREIGN KEY (id_aluno) REFERENCES aluno(id_aluno),

    -- Relaciona a matrícula com a tabela disciplina
    FOREIGN KEY (id_disciplina) REFERENCES disciplina(id_disciplina)
);
